PORT=8742
# bind address: 0.0.0.0 = reachable from the Tesla over your LAN/hotspot
HOST=0.0.0.0

# second port so the car can open http://<ip> without a port (run as admin on Windows)
ALT_PORT=80

# override only if the binaries are not on PATH
#FFMPEG=C:\ffmpeg\bin\ffmpeg.exe
#YT_DLP=yt-dlp

# public address of this server (tunnel / domain), used in hints and Twitch OAuth
#PUBLIC_URL=https://tv.example.com

# serve HTTPS directly from Node (PEM files) - use when there is no reverse proxy
#TLS_CERT=/etc/letsencrypt/live/example.com/fullchain.pem
#TLS_KEY=/etc/letsencrypt/live/example.com/privkey.pem

# ffmpeg input decoder: auto (default), d3d11va, cuda, qsv, off
#HWACCEL=auto

# audio quality of the second pipe (kept low so the browser buffer stays small)
AUDIO_BITRATE=96k

# Twitch OAuth (optional - only needed to import your follows)
TWITCH_CLIENT_ID=your_client_id_here
TWITCH_CLIENT_SECRET=your_client_secret_here
# leave empty to derive the redirect from the address you open the app with
#TWITCH_REDIRECT_URI=http://localhost:8742/api/twitch/callback
